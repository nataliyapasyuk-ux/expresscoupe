# Токен бота от @BotFather
BOT_TOKEN=

# ID рабочей группы, куда падают карточки лидов (с минусом, для супергрупп)
LEADS_CHAT_ID=

# ID Google-таблицы (из URL: /spreadsheets/d/<этот_id>/edit)
SHEET_ID=

# Путь к JSON-ключу сервисного аккаунта Google (см. README)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Название листа с лидами и листа с настройками
LEADS_SHEET_NAME=Лиды
SETTINGS_SHEET_NAME=Настройки

# Как часто перечитывать лист «Настройки», мс (по умолчанию 2 минуты)
SETTINGS_REFRESH_MS=120000

# Путь к файлу SQLite для состояния диалогов
DB_FILE=./data/bot.db

# Telegram user_id владелицы — только ей доступна команда /post_channel
OWNER_ID=

# Юзернейм канала, куда постим (с @)
CHANNEL_USERNAME=@expresskupe

# Юзернейм бота (для диплинка в кнопке поста), без @
BOT_USERNAME=
